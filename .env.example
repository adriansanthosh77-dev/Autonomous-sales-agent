# Autonomous Sales System - Environment Variables
# Copy to .env and fill in your values

# CLAUDE API (Anthropic)
CLAUDE_API_KEY=sk-your-key-here

# DATABASE (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# EMAIL ENRICHMENT (Hunter.io)
# Free tier: 25 searches/month
HUNTER_API_KEY=your-hunter-api-key

# B2B LEADS (Apollo.io)
# Free tier: 100 searches/month
APOLLO_API_KEY=your-apollo-api-key

# COMPANY ENRICHMENT (Clearbit)
# Free tier: 100 verifications/month
CLEARBIT_API_KEY=your-clearbit-api-key

# LINKEDIN SCRAPING (optional, use with caution)
LINKEDIN_EMAIL=your-linkedin-email@gmail.com
LINKEDIN_PASSWORD=your-linkedin-password

# GMAIL API (for sending emails & watching replies)
# Download from Google Cloud Console
GMAIL_CREDENTIALS_JSON=/path/to/google_credentials.json

# EMAIL DELIVERY
# Use "dry_run" for safe local testing or "smtp" for real sends
EMAIL_DELIVERY_MODE=dry_run
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=Autonomous Sales
SMTP_USE_TLS=true

# CALENDLY (for booking meetings)
CALENDLY_API_KEY=your-calendly-api-key

# OPENAI (optional fallback)
OPENAI_API_KEY=sk-...

# REDIS (for job queue)
REDIS_URL=redis://localhost:6379

# DATABASE (if using PostgreSQL instead of Supabase)
DATABASE_URL=postgresql://user:password@localhost/dbname

# ENVIRONMENT
ENVIRONMENT=development
DEBUG=true

# API KEYS
SECRET_KEY=your-secret-key-for-jwt

# FRONTEND URL (for CORS)
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:8000

# BACKEND PORT
BACKEND_PORT=8000

# MCP SERVER
# MCP_DRY_RUN=true keeps provider tools safe locally while preserving production payload shape.
MCP_SERVICE_NAME=autonomous-sales-agent
MCP_DRY_RUN=true
MCP_REQUEST_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=3
MCP_RETRY_BACKOFF_SECONDS=0.8
BACKEND_API_URL=http://localhost:8000

# GOOGLE WORKSPACE
GOOGLE_SHEETS_CREDENTIALS_JSON=/path/to/google_sheets_credentials.json
GOOGLE_SHEETS_DEFAULT_SPREADSHEET_ID=your-google-sheet-id
GMAIL_DELEGATED_USER=sales@yourdomain.com

# WHATSAPP BUSINESS
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-token

# GROWTH + MARKETING STACK
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
META_ADS_ACCESS_TOKEN=your-meta-token
META_ADS_ACCOUNT_ID=act-id-without-act-prefix
GA4_PROPERTY_ID=properties/123456789
GSC_SITE_URL=https://yourdomain.com/
GTM_ACCOUNT_ID=your-gtm-account-id
GTM_CONTAINER_ID=your-gtm-container-id
GTM_WORKSPACE_ID=your-gtm-workspace-id
CONTENTFUL_SPACE_ID=your-contentful-space-id
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_MANAGEMENT_TOKEN=your-contentful-management-token
ITERABLE_API_KEY=your-iterable-api-key
ITERABLE_BASE_URL=https://api.iterable.com/api

# INFRASTRUCTURE AUTOMATION
TRIGGERDEV_API_KEY=your-triggerdev-api-key
TRIGGERDEV_BASE_URL=https://api.trigger.dev
TRIGGERDEV_PROJECT_REF=proj_your_project_ref
WEBHOOK_SIGNING_SECRET=change-me
MCP_ALLOWED_WEBHOOK_SOURCES=gmail,whatsapp,ga4,google_ads,meta_ads,iterable,contentful,triggerdev
